# API 키 설정 파일의 견본입니다. (이 파일에는 진짜 키를 넣지 마세요)
# 사용법: 같은 폴더에 ".env" 라는 이름으로 복사한 뒤 아래 값을 채우세요.
#   copy agent_server\.env.example agent_server\.env
# 주의: ".env" 는 절대 깃에 올리거나 공유하지 마세요. (.gitignore 로 막아 두었어요)

OPENAI_API_KEY=
SONIOX_API_KEY=
GEMINI_API_KEY=
# (실험) TTS 를 여러 키로 나눠 보낼 때 두 번째, 세 번째 키 (없으면 비워 두거나 지우기)
# GEMINI_API_KEY2=
# Jev 로 업무 유형 분류와 말 끝 판정에 씁니다. 없으면 키워드 분류 + 무음 800ms 로 동작합니다
TYPESAFE_API_KEY=

# ── 아래는 선택 사항입니다 (필요할 때만 앞의 # 을 지우고 쓰세요) ──
# LLM_EFFORT=low
# END_SILENCE_MS=800
# LONG_SILENCE_MS=1800
# TTS_STREAM=1
# TTS_PER_SENTENCE=0
# TTS_VOICE=Kore
# TTS_STYLE="차분하고 자연스러운 한국어 상담원 말투"
# VERBOSE=1
# (실험) 말하기 방식과 업무 분류
# TTS_MODE=parallel_stream
# CASE_ROUTER=jev
# ANNOUNCE=static
# SERVER_LOG=runs/server.jsonl
# 말 끝 판정 (Jev): 쉬는 동안 EOT_EVERY_MS 마다 end/hold 를 묻는다. end → EOT_END_MS 에 끊음, hold → EOT_HOLD_MS 까지 기다림
# EOT_MODE=jev
# EOT_FIRST_MS=250
# EOT_EVERY_MS=200
# EOT_END_MS=650
# EOT_HOLD_MS=2500
# EOT_MIN_PROB=0.75
