# API 키 설정 파일의 견본입니다. (이 파일에는 진짜 키를 넣지 마세요)
# 사용법: 같은 폴더에 ".env" 라는 이름으로 복사한 뒤 아래 값을 채우세요.
#   copy agent_server\.env.example agent_server\.env
# 주의: ".env" 는 절대 깃에 올리거나 공유하지 마세요. (.gitignore 로 막아 두었어요)

OPENAI_API_KEY=
SONIOX_API_KEY=
GEMINI_API_KEY=

# ── 아래는 선택 사항입니다 (필요할 때만 앞의 # 을 지우고 쓰세요) ──
# LLM_EFFORT=low
# END_SILENCE_MS=800
# LONG_SILENCE_MS=1800
# TTS_STREAM=1
# TTS_PER_SENTENCE=0
# TTS_VOICE=Kore
# TTS_STYLE="Say: "
# VERBOSE=1
